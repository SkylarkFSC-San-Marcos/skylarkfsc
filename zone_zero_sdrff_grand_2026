<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zone Zero Grant Application</title>
<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
        background: #f5f7f8;
        margin: 0;
        padding: 30px;
    }

    .container {
        max-width: 850px;
        margin: auto;
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.1);
    }

    h1 {
        color: #1b5e20;
        margin-bottom: 10px;
    }

    .subtitle {
        color: #555;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        display: block;
        font-weight: bold;
        margin-bottom: 8px;
    }

    input[type="text"],
    input[type="email"],
    input[type="tel"],
    textarea,
    select {
        width: 100%;
        padding: 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-sizing: border-box;
    }

    textarea {
        min-height: 120px;
    }

    .upload-box {
        border: 2px dashed #999;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
        background: #fafafa;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    button {
        background: #2e7d32;
        color: white;
        border: none;
        padding: 14px 24px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 16px;
    }

    button:hover {
        background: #1b5e20;
    }

    .notice {
        background: #fff8e1;
        border-left: 5px solid #ffb300;
        padding: 15px;
        margin-bottom: 25px;
        border-radius: 4px;
    }
</style>
</head>
<body>

<div class="container">

    <h1>Zone Zero Fence & Gate Replacement Grant Application</h1>

    <p class="subtitle">
        Apply for assistance to replace combustible fencing and gates with
        non-combustible materials to improve wildfire resilience.
    </p>

    <div class="notice">
        <strong>Please include clear photos of the fence and/or gate to be replaced.</strong>
        Applications without photos may not be considered.
    </div>

    <form id="grantApplication">

        <div class="form-group">
            <label for="name">Applicant Name *</label>
            <input type="text" id="name" name="name" required>
        </div>

        <div class="form-group">
            <label for="address">Property Address *</label>
            <input type="text" id="address" name="address" required>
        </div>

        <div class="form-group">
            <label for="email">Email Address *</label>
            <input type="email" id="email" name="email" required>
        </div>

        <div class="form-group">
            <label for="phone">Phone Number *</label>
            <input type="tel" id="phone" name="phone" required>
        </div>

        <div class="form-group">
            <label for="projectType">Project Type *</label>
            <select id="projectType" name="projectType" required>
                <option value="">Select...</option>
                <option>Fence Replacement</option>
                <option>Gate Replacement</option>
                <option>Fence and Gate Replacement</option>
            </select>
        </div>

        <div class="form-group">
            <label for="description">
                Description of Existing Fence/Gate
            </label>
            <textarea id="description" name="description"
                placeholder="Describe current materials, condition, and approximate length."></textarea>
        </div>

        <div class="form-group">
            <label>Upload Existing Fence/Gate Photos *</label>
            <div class="upload-box">
                <input type="file"
                       id="photos"
                       name="photos"
                       accept="image/*"
                       multiple
                       required>
                <p>Select one or more photos showing the existing fence and/or gate.</p>
            </div>
        </div>

        <div class="form-group checkbox-group">
            <input type="checkbox" id="certify" required>
            <label for="certify">
                I certify that the information and photos submitted are accurate.
            </label>
        </div>

        <button type="submit">Submit Application</button>

    </form>

</div>

<script>
document.getElementById('grantApplication').addEventListener('submit', function(e) {
    e.preventDefault();

    alert(
        'Thank you. Your Zone Zero Grant Application has been submitted.'
    );

    // Replace with actual upload/database logic.
});
</script>

</body>
</html>
