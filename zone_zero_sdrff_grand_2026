                    <li><a href="donate.html" class="nav__link">Donate</a></li>
                </ul>
            </nav>

        </div>
    </header>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1 class="page-header__title">
                Zone Zero Fence & Gate Grant Application
            </h1>

            <p class="page-header__breadcrumb">
                <a href="index.html">Home</a> /
                <a href="programs.html">Programs</a> /
                Zone Zero Grant
            </p>
        </div>
    </section>

    <!-- Main Content -->
    <section class="section">
        <div class="container">

            <div class="application-container">

                <div class="grant-intro">
                    <h2>Improve Your Home's Wildfire Resilience</h2>

                    <p>
                        Skylark Fire Safe Council may provide funding assistance
                        for replacing combustible fencing and gates adjacent to
                        homes with non-combustible, wildfire-resistant materials.
                    </p>

                    <ul class="grant-benefits">
                        <li>Reduce ignition risk within Zone Zero.</li>
                        <li>Improve home hardening against embers.</li>
                        <li>Support community wildfire resilience goals.</li>
                        <li>Advance Firewise and defensible space objectives.</li>
                    </ul>
                </div>

                <div class="grant-notice">
                    <strong>Important:</strong>
                    Please upload clear photos showing the existing fence and/or
                    gate. Applications without photos cannot be evaluated.
                </div>

                <div class="form-card">

                    <form id="zoneZeroGrantApplication">

                        <h2 class="section-header">
                            Applicant Information
                        </h2>

                        <div class="form-group">
                            <label>
                                Applicant Name
                                <span class="required">*</span>
                            </label>
                            <input
                                type="text"
                                name="applicantName"
                                required>
                        </div>

                        <div class="form-group">
                            <label>
                                Property Address
                                <span class="required">*</span>
                            </label>
                            <input
                                type="text"
                                name="propertyAddress"
                                required>
                        </div>

                        <div class="form-group">
                            <label>
                                Email Address
                                <span class="required">*</span>
                            </label>
                            <input
                                type="email"
                                name="email"
                                required>
                        </div>

                        <div class="form-group">
                            <label>
                                Phone Number
                                <span class="required">*</span>
                            </label>
                            <input
                                type="tel"
                                name="phone"
                                required>
                        </div>

                        <h2 class="section-header">
                            Project Information
                        </h2>

                        <div class="form-group">
                            <label>
                                Project Type
                                <span class="required">*</span>
                            </label>

                            <select
                                name="projectType"
                                required>

                                <option value="">
                                    Select Project Type
                                </option>

                                <option value="Fence Replacement">
                                    Fence Replacement
                                </option>

                                <option value="Gate Replacement">
                                    Gate Replacement
                                </option>

                                <option value="Fence and Gate Replacement">
                                    Fence and Gate Replacement
                                </option>

                            </select>
                        </div>

                        <div class="form-group">
                            <label>
                                Approximate Linear Feet
                            </label>

                            <input
                                type="number"
                                name="linearFeet"
                                min="0">
                        </div>

                        <div class="form-group">
                            <label>
                                Existing Fence/Gate Material
                            </label>

                            <input
                                type="text"
                                name="existingMaterial"
                                placeholder="Example: Wood, Vinyl, Composite">
                        </div>

                        <div class="form-group">
                            <label>
                                Proposed Replacement Material
                            </label>

                            <input
                                type="text"
                                name="newMaterial"
                                placeholder="Example: Steel, Aluminum, Masonry">
                        </div>

                        <div class="form-group">
                            <label>
                                Project Description
                            </label>

                            <textarea
                                name="projectDescription"
                                placeholder="Provide details about the existing fence/gate, condition, and replacement proposal."></textarea>
                        </div>

                        <h2 class="section-header">
                            Photo Uploads
                        </h2>

                        <div class="form-group">

                            <label>
                                Existing Fence/Gate Photos
                                <span class="required">*</span>
                            </label>

                            <div class="upload-area">

                                <input
                                    type="file"
                                    name="beforePhotos"
                                    accept="image/*"
                                    multiple
                                    required>

                                <p>
                                    Upload one or more photos showing the
                                    current fence and/or gate.
                                </p>

                            </div>
                        </div>

                        <div class="checkbox-row">

                            <input
                                type="checkbox"
                                id="certify"
                                required>

                            <label for="certify">
                                I certify that the information and photographs
                                submitted are accurate and represent the current
                                condition of the property.
                            </label>

                        </div>

                        <div class="submit-area">

                            <button
                                type="submit"
                                class="btn btn--primary btn--lg">
                                Submit Application
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </section>

