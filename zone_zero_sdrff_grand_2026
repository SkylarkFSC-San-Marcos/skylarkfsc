<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        Zone Zero Fence & Gate Grant Application |
        Skylark Fire Safe Council
    </title>

    <meta name="description"
          content="Apply for Skylark Fire Safe Council funding assistance to replace combustible fencing and gates with wildfire-resistant non-combustible materials.">

    <link rel="stylesheet" href="css/styles.css">

    <style>
        .application-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .grant-intro {
            background: #f4fbf5;
            border-left: 5px solid #2e7d32;
            padding: 1.5rem;
            margin-bottom: 2rem;
            border-radius: 6px;
        }

        .grant-notice {
            background: #fff8e1;
            border-left: 5px solid #f39c12;
            padding: 1rem;
            margin-bottom: 2rem;
            border-radius: 6px;
        }

        .form-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
            padding: 2rem;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: .5rem;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px;
            border: 1px solid #d6d6d6;
            border-radius: 6px;
            font-size: 1rem;
            box-sizing: border-box;
        }

        .form-group textarea {
            resize: vertical;
            min-height: 120px;
        }

        .upload-area {
            border: 2px dashed #aaa;
            border-radius: 8px;
            padding: 1.25rem;
            background: #fafafa;
        }

        .checkbox-row {
            display: flex;
            gap: 10px;
            align-items: flex-start;
            margin-top: 1rem;
        }

        .checkbox-row input {
            width: auto;
            margin-top: 4px;
        }

        .required {
            color: #c62828;
        }

        .section-header {
            margin-top: 2rem;
            margin-bottom: 1rem;
            color: #1b5e20;
        }

        .submit-area {
            margin-top: 2rem;
            text-align: center;
        }

        .grant-benefits {
            margin-top: 1rem;
            margin-bottom: 2rem;
        }

        .grant-benefits li {
            margin-bottom: .5rem;
        }
    </style>
</head>

<body>

    <!-- Top Bar -->
    <div class="top-bar">
        <div class="top-bar__container">
            <div class="top-bar__left">
