                    <span>Protecting Our Community</span>
                </div>
            </a>

            <nav class="nav">
                <button class="nav__toggle" aria-label="Toggle navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <ul class="nav__list">
                    <li><a href="index.html" class="nav__link">Home</a></li>
